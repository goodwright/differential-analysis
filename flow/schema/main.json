{
    "inputs": [
        {
            "name": "Input Data",
            "modes": ["Flow Samples", "Provide File"],
            "params": {
                "counts": {
                    "name": "Counts",
                    "type": "data",
                    "modes": ["Flow Samples", "Provide File"],
                    "pattern": "csv|tsv",
                    "required": true,
                    "description": "A table file with whole number counts."
                },
                "samplesheet": {
                    "name": "Samples",
                    "type": "csv",
                    "modes": ["Flow Samples"],
                    "columns": [
                        {
                            "name": "sample_id",
                            "type": "string",
                            "render": true,
                            "required": true,
                            "from_sample": "name"
                        },
                        {
                            "name": "condition",
                            "type": "string",
                            "render": true,
                            "required": true
                        }
                    ],
                    "required": true,
                    "description": "A list of sample IDs with their condition indicator. The sample IDs here must match those used in the corresponding counts file. You can provide additional columns if you wish.",
                    "takes_samples": true,
                    "allow_custom_columns": true
                },
                "samplesheet_": {
                    "key": "samplesheet",
                    "name": "Samples",
                    "type": "data",
                    "modes": ["Provide File"],
                    "pattern": "csv|xlsx",
                    "required": true,
                    "description": "A list of sample IDs with their condition indicator. The sample IDs here must match those used in the corresponding counts file. You can provide additional columns if you wish."
                }
            },
            "advanced": false,
            "description": "Required input data"
        },
        {
            "name": "Pipeline Options",
            "params": {
                "organism": {
                    "name": "GSEA Organism",
                    "type": "string",
                    "valid": ["Human", "Mouse", "Chicken", "Fly", "Zebrafish", "Rat", "Yeast", "Ecoli-K12", ""],
                    "default": "",
                    "required": false,
                    "description": "Sets the genekit organism type for GSEA analysis."
                },
                "study_name": {
                    "name": "Study Name",
                    "type": "string",
                    "default": "study",
                    "required": false,
                    "description": "The name of the study."
                },
                "comparisons": {
                    "name": "Comparisons",
                    "type": "string",
                    "default": "all",
                    "required": false,
                    "description": "Sets the comparisons to calculate. Defaults to all against all. To specify comparisons use the variables names to compare separated by an underscore to specify a single comparison and then list them using a colon separator. For example, C_A:B_C"
                },
                "volcano_pvalue": {
                    "name": "Volcano plot p-value",
                    "type": "number",
                    "default": 0.01,
                    "required": false,
                    "description": "The p-value threshold to highlight on the plot."
                },
                "contrast_column": {
                    "name": "Contrast column",
                    "type": "string",
                    "default": "condition",
                    "required": false,
                    "description": "The column name in the count matrix to be used for contrast."
                },
                "blocking_factors": {
                    "name": "Blocking factors",
                    "type": "string",
                    "default": "",
                    "required": false,
                    "description": "Column names to be used for block factors in the differential analysis model."
                },
                "volcano_foldchange": {
                    "name": "Volcano plot fold change",
                    "type": "number",
                    "default": 2,
                    "required": false,
                    "description": "The fold change threshold to highlight on the plot."
                }
            },
            "advanced": false,
            "description": "Pipeline run parameters"
        },
        {
            "name": "Advanced Pipeline Options",
            "params": {
                "count_sep": {
                    "name": "Count separator",
                    "type": "string",
                    "required": false,
                    "description": "The text delimiter which separates columns in the input count matrix file."
                }
            },
            "advanced": true,
            "description": "Advanced Pipeline run parameters"
        },
        {
            "name": "Advanced DESeq2 Options",
            "params": {
                "dsq_test": {
                    "name": "Test type",
                    "type": "string",
                    "valid": ["Wald", "LRT"],
                    "default": "Wald",
                    "required": true,
                    "description": "DESeq2 test type."
                },
                "dsq_alpha": {
                    "name": "Alpha",
                    "type": "number",
                    "default": 0.1,
                    "required": false,
                    "description": "The significance cutoff used for optimizing the independent filtering."
                },
                "dsq_minmu": {
                    "name": "Min Mu",
                    "type": "number",
                    "default": 0.5,
                    "required": false,
                    "description": "Lower bound on the estimated count (used when calculating contrasts)."
                },
                "dsq_sf_type": {
                    "name": "Size factor estimation type",
                    "type": "string",
                    "valid": ["ratio", "poscounts", "iterate"],
                    "default": "ratio",
                    "required": true,
                    "description": "DESeq2 size factor estimation type."
                },
                "dsq_fit_type": {
                    "name": "Fit type",
                    "type": "string",
                    "valid": ["parametric", "local", "mean", "glmGamPoi"],
                    "default": "parametric",
                    "required": true,
                    "description": "DESeq2 fit type."
                },
                "dsq_lfc_threshold": {
                    "name": "Lfc Threshold",
                    "type": "number",
                    "default": 0,
                    "required": false,
                    "description": "A non-negative value which specifies a log2 fold change threshold."
                },
                "dsq_alt_hypothesis": {
                    "name": "Alt hypothesis type",
                    "type": "string",
                    "valid": ["greaterAbs", "lessAbs", "greater", "less"],
                    "default": "greaterAbs",
                    "required": true,
                    "description": "DESeq2 alt hypothesis type."
                },
                "dsq_lfcshrink_type": {
                    "name": "Lfc shrink type",
                    "type": "string",
                    "valid": ["ashr", "apeglm", "normal"],
                    "default": "ashr",
                    "required": true,
                    "description": "DESeq2 Lfc shrink type."
                },
                "dsq_min_replicates_for_replace": {
                    "name": "Min replicates",
                    "type": "number",
                    "default": 7,
                    "required": false,
                    "description": "The minimum number of replicates required in order to use replaceOutliers on a sample."
                }
            },
            "advanced": true,
            "description": "Advanced DESeq2 parameters"
        },
        {
            "name": "Advanced GSEA Options",
            "params": {
                "dsq_p_thresh": {
                    "name": "DESeq2 p-value Threshold",
                    "type": "number",
                    "default": 1,
                    "required": false,
                    "description": "p-value cut off for filtering input deseq2 results table."
                },
                "gsea_ontology": {
                    "name": "GSEA Ontology type",
                    "type": "string",
                    "valid": ["mf", "bp", "cc"],
                    "default": "mf",
                    "required": true,
                    "description": " Biological Processes (BP) | Molecular Functions (MF) | Cellular Components (CC)"
                },
                "gsea_p_cutoff": {
                    "name": "GSEA p-value Threshold",
                    "type": "number",
                    "default": 0.05,
                    "required": false,
                    "description": "Numeric of cutoff for both p-value and adjusted p-value."
                },
                "gsea_q_cutoff": {
                    "name": "GSEA q-value Threshold",
                    "type": "number",
                    "default": 0.15,
                    "required": false,
                    "description": "Numeric of cutoff for q-value, default should be 0.15."
                },
                "gsea_scale_ratio": {
                    "name": "Plot scale ratio",
                    "type": "number",
                    "default": 0.1,
                    "required": false,
                    "description": "Plot scale ratio."
                },
                "gsea_term_metric": {
                    "name": "GSEA term metric",
                    "type": "string",
                    "valid": ["FoldEnrich", "GeneRatio", "Count", "RichFactor"],
                    "default": "FoldEnrich",
                    "required": true,
                    "description": "Stats metric for the plots."
                },
                "gsea_stats_metric": {
                    "name": "GSEA stats metric",
                    "type": "string",
                    "valid": ["p.adjust", "pvalue", "qvalue"],
                    "default": "p.adjust",
                    "required": true,
                    "description": "Stats metric for the plots."
                },
                "gsea_max_gset_size": {
                    "name": "GSEA max gene set size",
                    "type": "number",
                    "default": 500,
                    "required": false,
                    "description": "Max size of each gene set for analysis."
                },
                "gsea_min_gset_size": {
                    "name": "GSEA min gene set size",
                    "type": "number",
                    "default": 10,
                    "required": false,
                    "description": "Minimal size of each gene set for analysis."
                },
                "gsea_pathway_count": {
                    "name": "GSEA pathway count",
                    "type": "number",
                    "default": 10,
                    "required": false,
                    "description": "How many pathways to show on the plots."
                },
                "gsea_main_text_size": {
                    "name": "Plot text size",
                    "type": "number",
                    "default": 5,
                    "required": false,
                    "description": "Plot text size."
                },
                "gsea_p_adjust_method": {
                    "name": "GSEA p-adjust method",
                    "type": "string",
                    "valid": ["BH", "holm", "hochberg", "hommel", "bonferroni", "BY", "fdr", "none"],
                    "default": "BH",
                    "required": true,
                    "description": "p-value adjustment method"
                },
                "gsea_legend_text_size": {
                    "name": "Plot legend text size",
                    "type": "number",
                    "default": 8,
                    "required": false,
                    "description": "Plot legend text size."
                }
            },
            "advanced": true,
            "description": "Advanced GSEA parameters"
        },
        {
            "name": "DESeq2 designs and separate module tests",
            "advanced": true,
            "description": "Explicit DESeq2 designs and contrasts, with a separate optional CAMERA module test.",
            "params": {
                "analysis_mode": {
                    "name": "Analysis mode",
                    "type": "string",
                    "valid": ["pairwise", "design_contrasts"],
                    "default": "pairwise",
                    "description": "Pairwise DESeq2, or explicit DESeq2 designs and numeric contrasts with an optional separate CAMERA module test.",
                    "required": false
                },
                "design_formula": {
                    "name": "Design formula",
                    "type": "string",
                    "default": "",
                    "description": "Advanced mode: one-sided formula using samplesheet columns, e.g. ~ 0 + pair + poly + poly:ko1 + poly:ko9. Rank-deficient models are rejected.",
                    "required": false
                },
                "contrast_table": {
                    "name": "Contrast weights",
                    "type": "data",
                    "pattern": "csv|tsv",
                    "description": "Required in advanced mode: contrast, coefficient, weight columns. Exact design-matrix coefficient names; no R expressions.",
                    "required": false
                },
                "numeric_covariates": {
                    "name": "Numeric covariates",
                    "type": "string",
                    "default": "",
                    "description": "Comma-separated numeric model columns; other model columns are categorical. Example: poly,ko1,ko9.",
                    "required": false
                },
                "gene_sets": {
                    "name": "Fixed gene modules",
                    "type": "data",
                    "pattern": "gmt",
                    "description": "Fixed GMT modules, required with module_test=camera; no modules are chosen from observed differential results.",
                    "required": false
                },
                "gene_universe": {
                    "name": "Competitive gene universe",
                    "type": "data",
                    "pattern": "txt",
                    "description": "Optional prespecified module-plus-background gene IDs for CAMERA only. Does not restrict DESeq2 gene tests or normalization.",
                    "required": false
                },
                "gene_set_id_column": {
                    "name": "Gene-set identifier",
                    "type": "string",
                    "valid": ["gene_id", "gene_name"],
                    "default": "gene_id",
                    "description": "Count-table column matching GMT/universe IDs. IDs must be unique; ambiguous mappings fail.",
                    "required": false
                },
                "count_matrix_type": {
                    "name": "Count matrix type",
                    "type": "string",
                    "valid": ["raw_counts", "length_scaled_counts"],
                    "default": "raw_counts",
                    "description": "raw_counts must be integer. Explicit tximport lengthScaledTPM count estimates use length_scaled_counts; DESeq2 rounds these with a recorded rounding audit, CAMERA uses unrounded estimates. TPM/log expression is not supported.",
                    "required": false
                },
                "filter_column": {
                    "name": "Expression filter column",
                    "type": "string",
                    "default": "",
                    "description": "Optional sample column restricting expression eligibility, e.g. fraction. Empty uses all samples.",
                    "required": false
                },
                "filter_level": {
                    "name": "Expression filter level",
                    "type": "string",
                    "default": "",
                    "description": "Value used for expression eligibility, e.g. input.",
                    "required": false
                },
                "min_cpm": {
                    "name": "Minimum CPM",
                    "type": "number",
                    "default": 1,
                    "description": "Expression threshold before fitting.",
                    "required": false
                },
                "min_samples": {
                    "name": "Minimum expressed samples",
                    "type": "number",
                    "default": 2,
                    "description": "Number of filter-eligible samples meeting minimum CPM.",
                    "required": false
                },
                "min_set_size": {
                    "name": "Minimum retained module size",
                    "type": "number",
                    "default": 10,
                    "required": false
                },
                "max_set_size": {
                    "name": "Maximum retained module size",
                    "type": "number",
                    "default": 500,
                    "required": false
                },
                "set_adjust_method": {
                    "name": "Module multiple-test correction",
                    "type": "string",
                    "valid": ["BH", "holm", "bonferroni"],
                    "default": "BH",
                    "description": "Across all tested module-by-contrast combinations in this execution. Raw p-values also retained.",
                    "required": false
                },
                "model_seed": {
                    "name": "Model random seed",
                    "type": "number",
                    "default": 20261002,
                    "required": false
                },
                "custom_model_container": {
                    "name": "Advanced model container",
                    "type": "string",
                    "description": "Tested Linux amd64 DESeq2/CAMERA runtime, pinned by digest. Overrides must identify a compatible immutable image; ensure the execution environment can pull it.",
                    "required": false,
                    "default": "ghcr.io/charlotteanne/differential-analysis/advanced-model@sha256:6555b85f0de65ad43a31968014e8f2913b005dfeaf67fbd4a372199068f0a611"
                },
                "module_test": {
                    "name": "Module test",
                    "type": "string",
                    "default": "none",
                    "valid": ["none", "camera"],
                    "description": "Explicit optional limma-voom CAMERA process using the same design and contrasts. Requires fixed GMT gene sets. This is separate from DESeq2 gene-level testing.",
                    "required": false
                },
                "design_deseq_fit_type": {
                    "name": "Design DESeq2 dispersion fit",
                    "type": "string",
                    "default": "parametric",
                    "valid": ["parametric", "local", "mean"],
                    "required": false
                },
                "design_deseq_sf_type": {
                    "name": "Design DESeq2 size-factor method",
                    "type": "string",
                    "default": "ratio",
                    "valid": ["ratio", "poscounts"],
                    "required": false
                }
            }
        }
    ],
    "outputs": [
        {
            "name": "DESeq2 rds data file",
            "process": "R_DESEQ2",
            "filetype": "rds",
            "description": "R rds data object containing processed DESeq2 data."
        },
        {
            "name": "DESeq2 results",
            "process": "R_DESEQ2",
            "filetype": "tsv",
            "description": "Result data tables from DESeq2"
        },
        {
            "name": "DESeq2 plots",
            "process": "R_DESEQ2_PLOTS",
            "filetype": "pdf",
            "description": "DESeq2 standard plot outputs"
        },
        {
            "name": "Volcano plots",
            "process": "R_VOLCANO_PLOT",
            "filetype": "pdf",
            "description": "Standard volcano plot output."
        },
        {
            "name": "PCA Explorer plots",
            "process": "R_PCAEXPLORER",
            "filetype": "pdf",
            "description": "PCA Explorer output plots"
        },
        {
            "name": "GSEA data",
            "process": "R_GSEA",
            "filetype": "xlsx",
            "description": "GSEA output data"
        },
        {
            "name": "GSEA plots",
            "process": "R_GSEA",
            "filetype": "pdf",
            "description": "GSEA output plots"
        },
        {
            "name": "DESeq2 design audit",
            "process": "R_DESIGN_DESEQ2",
            "filetype": "json",
            "pattern": "model_audit.json",
            "description": "Model assumptions, sample order, filters and parameters"
        },
        {
            "name": "DESeq2 design tables",
            "process": "R_DESIGN_DESEQ2",
            "filetype": "tsv",
            "pattern": ".*\\.tsv$",
            "description": "Results and reproducibility tables"
        },
        {
            "name": "DESeq2 design fit",
            "process": "R_DESIGN_DESEQ2",
            "filetype": "rds",
            "pattern": "fitted_model.rds",
            "description": "Saved fitted object and numeric contrasts"
        },
        {
            "name": "CAMERA module audit",
            "process": "R_CAMERA_MODULE",
            "filetype": "json",
            "pattern": "model_audit.json",
            "description": "Model assumptions, sample order, filters and parameters"
        },
        {
            "name": "CAMERA module tables",
            "process": "R_CAMERA_MODULE",
            "filetype": "tsv",
            "pattern": ".*\\.tsv$",
            "description": "Results and reproducibility tables"
        },
        {
            "name": "CAMERA module fit",
            "process": "R_CAMERA_MODULE",
            "filetype": "rds",
            "pattern": "fitted_model.rds",
            "description": "Saved fitted object and numeric contrasts"
        }
    ]
}
