# Build/test this image and record its immutable digest before registering a Flow release.
FROM bioconductor/bioconductor_docker:RELEASE_3_19
RUN Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); install.packages(c("BiocManager", "jsonlite", "statmod", "locfit", "Rcpp")); BiocManager::install(version="3.19", ask=FALSE, update=FALSE); BiocManager::install("DESeq2", ask=FALSE, update=FALSE); install.packages("https://bioconductor.org/packages/3.19/bioc/src/contrib/limma_3.60.6.tar.gz", repos=NULL, type="source"); install.packages("https://bioconductor.org/packages/3.19/bioc/src/contrib/edgeR_4.2.2.tar.gz", repos=NULL, type="source"); stopifnot(as.character(packageVersion("DESeq2")) == "1.44.0", as.character(packageVersion("limma")) == "3.60.6", as.character(packageVersion("edgeR")) == "4.2.2")'
