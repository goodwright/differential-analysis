# Bioconductor 3.19.33 / R 4.4.1. Build and synthetic tests run before publication.
FROM bioconductor/bioconductor_docker:RELEASE_3_19@sha256:c74fd973f50818c4044225c8cfcf318fa11087d5df1b6a08a5a604abbe91195a
RUN Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); install.packages(c("BiocManager", "jsonlite", "statmod", "locfit", "Rcpp")); BiocManager::install(version="3.19", ask=FALSE, update=FALSE); BiocManager::install("DESeq2", ask=FALSE, update=FALSE); install.packages("https://bioconductor.org/packages/3.19/bioc/src/contrib/limma_3.60.6.tar.gz", repos=NULL, type="source"); install.packages("https://bioconductor.org/packages/3.19/bioc/src/contrib/edgeR_4.2.2.tar.gz", repos=NULL, type="source"); stopifnot(as.character(getRversion()) == "4.4.1", as.character(packageVersion("DESeq2")) == "1.44.0", as.character(packageVersion("limma")) == "3.60.6", as.character(packageVersion("edgeR")) == "4.2.2")'
RUN mkdir -p /opt/advanced-model && Rscript -e 'p <- installed.packages(); write.table(p[,c("Package","Version","Built")], "/opt/advanced-model/installed-packages.tsv", sep="\t", row.names=FALSE, quote=FALSE); capture.output(sessionInfo(), file="/opt/advanced-model/sessionInfo.txt")'
